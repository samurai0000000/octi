# Configuration for octi-server.service
OCTI_BIND_ADDRESS=127.0.0.1
OCTI_PORT=6874
OCTI_DB_PATH=/var/lib/octi/octi.db
OCTI_OIDC_CONFIG=/etc/octi/oidc.json
OCTI_BAN_CONFIG=/etc/octi/bans.json
OCTI_AVATAR_DIR=/var/octi/avatar
# Optional extra arguments (e.g., behind Apache2 TLS reverse proxy):
# OCTI_EXTRA_ARGS="--behind-tls --public-base-url https://octi.selfso.com"
OCTI_EXTRA_ARGS=""
