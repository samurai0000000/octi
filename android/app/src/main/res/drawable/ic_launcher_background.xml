<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Obsidian & Slate radial gradient base (#0B0F17 center to #05070B corners) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:type="radial">
                <item android:color="#FF131C2E" android:offset="0.0" />
                <item android:color="#FF0B0F17" android:offset="0.58" />
                <item android:color="#FF05070B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle recessed slate checkerboard grid squares inside the 27..81 center cells -->
    <path
        android:fillColor="#441D2940"
        android:pathData="M27,27h27v27h-27zM54,54h27v27h-27zM0,27h27v27h-27zM81,54h27v27h-27zM27,81h27v27h-27zM54,0h27v27h-27z" />
    <path
        android:fillColor="#44151E30"
        android:pathData="M54,27h27v27h-27zM27,54h27v27h-27z" />

    <!-- Recessed center square socket shadow -->
    <path
        android:fillColor="#3305070B"
        android:pathData="M31,31h46v46h-46z"
        android:strokeColor="#33C8A253"
        android:strokeWidth="0.6" />

    <!-- Inlaid brushed brass (#C8A253) grid hairlines at x=27, 54, 81 and y=27, 54, 81 -->
    <path
        android:pathData="M27,0L27,108M54,0L54,108M81,0L81,108M0,27L108,27M0,54L108,54M0,81L108,81"
        android:strokeColor="#44C8A253"
        android:strokeWidth="0.75" />

    <!-- Outer engraved octagonal home-base medallion ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41.0,22.6L67.0,22.6L85.4,41.0L85.4,67.0L67.0,85.4L41.0,85.4L22.6,67.0L22.6,41.0Z"
        android:strokeColor="#55C8A253"
        android:strokeWidth="1.2" />

    <!-- Inner subtle brass compass circle & corner bevel ticks -->
    <path
        android:fillColor="#00000000"
        android:pathData="M42.5,26.2L65.5,26.2L81.8,42.5L81.8,65.5L65.5,81.8L42.5,81.8L26.2,65.5L26.2,42.5Z"
        android:strokeColor="#33E4C070"
        android:strokeWidth="0.7" />
</vector>
